const productoras = require('../models/productora')

//obtener productoras
const obtenerProductoras = async (req, res) => {
    try {
        const productora = await productoras.find();
        res.json(productora); 
    }catch (error){
        console.log(error)
        res.status(500).json({
            mensaje: 'error al obtener las productoras'
        });
    }
};

//crear productora
const crearProductora = async (req, res) => {
    const {nombre, estado, slogan, descripcion} = req.body;

    try {
        const productora = new productoras ({nombre, estado, slogan, descripcion})

        //guaradamos en la base de datos
        await productora.save()

        res.status(200).json({
            mensaje: 'productora guardada correctamente', productora
        });
    }catch (error){
        console.log(error)
        res.status(500).json({
            mensaje: 'error al guardar las productoras'
        });
    };

};
//actualizar productora
const actualizarProductora = async (req, res) => {
    try{
        const {id} = req.params;
        const datosActualizados = req.body;
        datosActualizados.fechaActualizacion = Date.now();

         const productoraActualizada = await productoras.findByIdAndUpdate(id, datosActualizados, {returnDocumentL: 'after'});

        if(!productoraActualizada){
            return res.status(400).json({
                mensaje:'productora no encontrada'
            })
        }   
        res.json(productoraActualizada)

    }catch (error){
        console.log(error);
        res.status(500).json({
            mensaje: 'error al actualizar productora', error
        });
    }
};
//eliminar productora
const eliminarProductora = async (req, res) => {
    try{
        const {id} = req.params;
        const productoraEliminada = await productoras.findByIdAndDelete(id);
        
        if(!productoraEliminada){
            return res.status(400).json({
                mensaje: 'productora no encontrada'
            });
        }
        res.json({
            mensaje:'productora eliminada correctamente'
        });

    }catch (error){
        console.log(error);
        res.status(500).json({
            mensaje: 'error al eliminar productora', error
        });
    }
};

module.exports = {
    obtenerProductoras,
    crearProductora,
    actualizarProductora,
    eliminarProductora
};
