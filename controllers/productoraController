const productoras = require('../models/productora')

//obtener productoras
const obtenerProductoras = async (req, res) => {
    try {
        const productora = await productoras.find();
        res.json(productora); 
    }catch (error){
        console.log(error)
        res.status(500).json({
            mensaje: 'error al obtener las productoras'
        });
    }
};

//crear productora
const crearProductora = async (req, res) => {
    const {nombre, estado, slogan, descripcion} = req.body;

    try {
        const productora = new productoras ({nombre, estado, slogan, descripcion})

        //guaradamos en la base de datos
        await productora.save()

        res.status(200).json({
            mensaje: 'productora guardada correctamente', productora
        });
    }catch (error){
        console.log(error)
        res.status(500).json({
            mensaje: 'error al guardar las productoras'
        });
    };

};

module.exports = {
    obtenerProductoras,
    crearProductora
};
